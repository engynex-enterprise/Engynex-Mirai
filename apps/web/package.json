{
  "name": "web",
  "version": "5.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/gen-icons.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @mirai/db db:migrate",
    "db:migrate:prod": "pnpm --filter @mirai/db db:migrate:prod",
    "db:types": "pnpm --filter @mirai/db db:types",
    "legacy:extract": "node scripts/extract-legacy.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "pwa:assets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/pwa-assets.mjs",
    "pwa:screenshots": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/pwa-screenshots.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.94",
    "@ai-sdk/google": "^4.0.109",
    "@ai-sdk/groq": "^4.0.74",
