    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@hookform/resolvers": "^7.0.0",
    "@mirai/ai": "workspace:*",
    "@mirai/contracts": "workspace:*",
    "@mirai/crypto": "workspace:*",
    "@mirai/db": "workspace:*",
    "@mirai/domain": "workspace:*",
    "@mirai/services": "workspace:*",
    "@openrouter/ai-sdk-provider": "^3.1.0",
