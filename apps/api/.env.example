# Variables de la API (apps/api/src/core/config/config.schema.ts las valida al arrancar). SIN valores reales aquí.
# En local la API lee la .env.local de la raíz (acepta NEXT_PUBLIC_SUPABASE_URL / _PUBLISHABLE_KEY de la web).
# En Cloud Run: variables normales para lo público y --set-secrets (Secret Manager) para lo marcado [secreto].

MIRAI_ENV=local                     # local | pruebas | produccion
MODE=api                            # api | realtime (gateway de WebSocket, servicio aparte)
PORT=8080
LOG_LEVEL=info

SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=                # [secreto] obligatorio fuera de local (SystemScope, límites compartidos)
# SUPABASE_JWT_SECRET=              # [secreto] solo si el proyecto aún firma con HS256 (hoy: ES256 + JWKS)
# AUTH_JWKS_URL= AUTH_ISSUER= AUTH_AUDIENCE=authenticated   # por defecto salen de SUPABASE_URL

ENCRYPTION_KEY=                     # [secreto] 32 bytes en base64, LA MISMA de la web (nunca cambiarla)

WEB_ORIGINS=http://localhost:3000   # CORS, separados por coma; admite comodín: https://engynex-mirai-*.vercel.app
CRON_SECRET=                        # [secreto] transición: el Bearer que hoy usan Vercel y pg_cron
SCHEDULER_AUDIENCE=                 # URL del servicio de Cloud Run (audiencia del token OIDC)
SCHEDULER_SERVICE_ACCOUNTS=         # mirai-scheduler@<proyecto>.iam.gserviceaccount.com,…

DB_ADAPTER=supabase                 # supabase (fase 2) | pg (Cloud SQL, fase 4)
# DATABASE_URL=                     # [secreto] solo con DB_ADAPTER=pg
RATE_LIMIT_STORE=memory             # memory | supabase (rate_limit_hit, compartido con la web)
RATE_LIMIT_DEFAULT_PER_MIN=300
IDEMPOTENCY_STORE=memory            # memory | supabase (necesita la migración 20261103003800_api_idempotency.sql)

QUEUE_DRIVER=inline                 # inline | cloudtasks
# GCP_PROJECT= GCP_LOCATION=us-west1 TASKS_SERVICE_ACCOUNT= API_BASE_URL=

DOCS=1                              # /docs (OpenAPI); siempre apagado en produccion
# OpenTelemetry (apagado si no hay exportador): OTEL_TRACES_EXPORTER=otlp OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Tiempo real (F2-G, MODE=realtime = servicio mirai-realtime; ver apps/api/README.md › Tiempo real)
# REDIS_URL=                        # [secreto si lleva clave] Memorystore: varias instancias (adaptador + presencia). Sin ella, memoria
# REALTIME_PATH=/socket.io
# REALTIME_TOKEN_CHECK_S=600        # revisa token vencido y membresía cada 10 min
# REALTIME_PRESENCE_TTL_S=60        # presencia sin latido se olvida
# REALTIME_RECOVERY_S=120           # recuperación de la conexión (solo sin Redis)
# REALTIME_MAX_BOOKS=5  REALTIME_EVENTS_PER_10S=40
# REALTIME_PG_LISTEN=0              # 1 = LISTEN mirai_live (fase 4; necesita mirai_live_notify_install(true) en la base)
# REALTIME_DATABASE_URL=            # [secreto] conexión DIRECTA de sesión para LISTEN (si falta, DATABASE_URL)
# REALTIME_API_EMIT=1               # MODE=api: publica los cambios de la API en Redis para el gateway (si hay REDIS_URL)

# ── F2-E: avisos, integraciones, Google y trabajos (modules/integrations/services-env.ts) ──
SITE_URL=http://localhost:3000      # la web (enlaces de correos y avisos, regreso de Google). Por defecto según MIRAI_ENV
API_PUBLIC_URL=http://localhost:8080   # esta API (callback de Google: <API_PUBLIC_URL>/v1/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=               # [secreto]
GOOGLE_OAUTH_STATE_KEY=             # [secreto] HMAC del state de OAuth (32+ caracteres; openssl rand -base64 32)
VAPID_PUBLIC_KEY=                   # la misma NEXT_PUBLIC_VAPID_PUBLIC_KEY de la web
VAPID_PRIVATE_KEY=                  # [secreto]
VAPID_SUBJECT=mailto:soporte@mirai.app
# AI_GATEWAY_API_KEY=               # [secreto] solo para que el registro dé por lista la IA del despliegue
TICK_DAILY_TASKS=1                  # 0 si Cloud Scheduler ya llama aparte refs/calendar/net-worth/plan-reminders
AUTOMATIONS_OUTBOX=1                # encolar automations/book/:b después de cada escritura de la API

# ── F2-I: planes y pagos (modules/billing/billing.config.ts). SITE_URL (arriba) también arma invitaciones y retornos ──
MERCADOPAGO_ACCESS_TOKEN=           # [secreto] sin él, el pago con tarjeta se muestra deshabilitado
MERCADOPAGO_WEBHOOK_SECRET=         # [secreto] firma x-signature (obligatoria con MIRAI_ENV=produccion)
WOMPI_PUBLIC_KEY=                   # la misma NEXT_PUBLIC_WOMPI_PUBLIC_KEY de la web
WOMPI_INTEGRITY_SECRET=             # [secreto] firma de integridad del checkout
WOMPI_EVENTS_SECRET=                # [secreto] checksum de los eventos (webhook)
