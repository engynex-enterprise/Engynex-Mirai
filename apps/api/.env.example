# Variables de la API (apps/api/src/core/config/config.schema.ts las valida al arrancar). SIN valores reales aquí.
# En local la API lee la .env.local de la raíz (acepta NEXT_PUBLIC_SUPABASE_URL / _PUBLISHABLE_KEY de la web).
# En Cloud Run: variables normales para lo público y --set-secrets (Secret Manager) para lo marcado [secreto].

MIRAI_ENV=local                     # local | pruebas | produccion
MODE=api                            # api | realtime (gateway de WebSocket, servicio aparte)
PORT=8080
LOG_LEVEL=info

SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=                # [secreto] obligatorio fuera de local (SystemScope, límites compartidos)
# SUPABASE_JWT_SECRET=              # [secreto] solo si el proyecto aún firma con HS256 (hoy: ES256 + JWKS)
# AUTH_JWKS_URL= AUTH_ISSUER= AUTH_AUDIENCE=authenticated   # por defecto salen de SUPABASE_URL

ENCRYPTION_KEY=                     # [secreto] 32 bytes en base64, LA MISMA de la web (nunca cambiarla)

WEB_ORIGINS=http://localhost:3000   # CORS, separados por coma; admite comodín: https://engynex-mirai-*.vercel.app
CRON_SECRET=                        # [secreto] transición: el Bearer que hoy usan Vercel y pg_cron
SCHEDULER_AUDIENCE=                 # URL del servicio de Cloud Run (audiencia del token OIDC)
SCHEDULER_SERVICE_ACCOUNTS=         # mirai-scheduler@<proyecto>.iam.gserviceaccount.com,…

DB_ADAPTER=supabase                 # supabase (fase 2) | pg (Cloud SQL, fase 4)
# DATABASE_URL=                     # [secreto] solo con DB_ADAPTER=pg
RATE_LIMIT_STORE=memory             # memory | supabase (rate_limit_hit, compartido con la web)
RATE_LIMIT_DEFAULT_PER_MIN=300
IDEMPOTENCY_STORE=memory            # memory | supabase (necesita la migración 20261103003800_api_idempotency.sql)

QUEUE_DRIVER=inline                 # inline | cloudtasks
# GCP_PROJECT= GCP_LOCATION=us-west1 TASKS_SERVICE_ACCOUNT= API_BASE_URL=

DOCS=1                              # /docs (OpenAPI); siempre apagado en produccion
# OpenTelemetry (apagado si no hay exportador): OTEL_TRACES_EXPORTER=otlp OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
