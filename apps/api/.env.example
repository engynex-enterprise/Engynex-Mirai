# Variables de la API (apps/api/src/core/config/config.schema.ts las valida al arrancar). SIN valores reales aquí.
# En local la API lee la .env.local de la raíz (acepta NEXT_PUBLIC_SUPABASE_URL / _PUBLISHABLE_KEY de la web).
# En Cloud Run: variables normales para lo público y --set-secrets (Secret Manager) para lo marcado [secreto].

MIRAI_ENV=local                     # local | pruebas | produccion
MODE=api                            # api | realtime (gateway de WebSocket, servicio aparte) | worker (consume SQS/Service Bus, V7-F)
PORT=8080
LOG_LEVEL=info

SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=                # [secreto] obligatorio fuera de local (SystemScope, límites compartidos)
# SUPABASE_JWT_SECRET=              # [secreto] solo si el proyecto aún firma con HS256 (hoy: ES256 + JWKS)
# AUTH_JWKS_URL= AUTH_ISSUER= AUTH_AUDIENCE=authenticated   # por defecto salen de SUPABASE_URL

ENCRYPTION_KEY=                     # [secreto] 32 bytes en base64, LA MISMA de la web (nunca cambiarla)

WEB_ORIGINS=http://localhost:3000   # CORS, separados por coma; admite comodín: https://engynex-mirai-*.vercel.app
CRON_SECRET=                        # [secreto] transición: el Bearer que hoy usan Vercel y pg_cron
SCHEDULER_AUDIENCE=                 # URL del servicio de Cloud Run (audiencia del token OIDC)
SCHEDULER_SERVICE_ACCOUNTS=         # mirai-scheduler@<proyecto>.iam.gserviceaccount.com,…
# V7-F: emisor OIDC genérico para /v1/jobs/** (Azure Entra, Cognito de AWS u otro), además de Google y CRON_SECRET.
# SCHEDULER_OIDC_ISSUER=            # https://login.microsoftonline.com/<tenant>/v2.0 · https://cognito-idp.<región>.amazonaws.com/<pool>
# SCHEDULER_OIDC_JWKS_URL=          # opcional; si falta se descubre en <issuer>/.well-known/openid-configuration
# SCHEDULER_OIDC_AUDIENCE=          # api://mirai-api (vacía = no revisa aud: tokens de acceso de Cognito)
# SCHEDULER_OIDC_PRINCIPALS=        # coma; se comparan con sub, email, client_id, azp, appid u oid

DB_ADAPTER=supabase                 # supabase (fase 2) | pg (Postgres propia) | postgrest (puente interno, V7-D)
# POSTGREST_URL= POSTGREST_JWT_SECRET=   # [secreto el segundo] solo con DB_ADAPTER=postgrest
# DATABASE_URL=                     # [secreto] solo con DB_ADAPTER=pg
RATE_LIMIT_STORE=memory             # memory | supabase (rate_limit_hit, compartido con la web)
RATE_LIMIT_DEFAULT_PER_MIN=300
IDEMPOTENCY_STORE=memory            # memory | supabase (necesita la migración 20261103003800_api_idempotency.sql)

QUEUE_DRIVER=inline                 # inline | cloudtasks | sqs | servicebus | http   (V7-F; SDK solo en src/adapters/<nube>)
# GCP_PROJECT= GCP_LOCATION=us-west1 TASKS_SERVICE_ACCOUNT= API_BASE_URL=
# QUEUE_NOTIFY= QUEUE_AUTOMATIONS= QUEUE_SLOW=   # URL de SQS (.fifo = deduplicación), nombre en Service Bus o id en Cloud Tasks
# QUEUE_DEDUPE=memory               # memory | redis (REDIS_URL) | none — evita encolar dos veces el mismo nombre
# QUEUE_DEDUPE_TTL_S=86400
# SQS_ENDPOINT=                     # ElasticMQ/LocalStack en local. AWS_REGION si no sale de la URL de la cola
# SERVICEBUS_NAMESPACE=             # <ns>.servicebus.windows.net (identidad administrada; AZURE_CLIENT_ID opcional)
# SERVICEBUS_CONNECTION_STRING=     # [secreto] alternativa (Azurite/emulador o sin identidad administrada)
# Trabajador (MODE=worker): despacha cada tarea por POST a TASKS_TARGET_URL (o API_BASE_URL) + ruta
# TASKS_TARGET_URL=  TASKS_AUTH=secret   # secret (CRON_SECRET) | gcp | azure | client_credentials
# TASKS_AUDIENCE=                   # audiencia (gcp) o recurso de Entra (azure), p. ej. api://mirai-api
# TASKS_TOKEN_URL= TASKS_CLIENT_ID= TASKS_SCOPE=   TASKS_CLIENT_SECRET=   # [secreto el último] OAuth2 client credentials
# TASKS_TIMEOUT_S=300 TASKS_MAX_ATTEMPTS=5 TASKS_RETRY_BASE_S=10 TASKS_RETRY_MAX_S=900
# WORKER_QUEUES=notify,automations,slow WORKER_CONCURRENCY=4 WORKER_SHUTDOWN_S=25

# Secretos (V7-F, D8): SIEMPRE variables de entorno que llena la plataforma (Secret Manager → Cloud Run, Secrets
# Manager → ECS, Key Vault → Container Apps). Adaptador opcional, apagado: con gcp|aws|azure resuelve al arrancar los
# valores `secret://<referencia>` (y `#campo` de un JSON) con la identidad del servicio.
SECRETS_SOURCE=env                  # env | gcp | aws | azure

DOCS=1                              # /docs (OpenAPI); siempre apagado en produccion
# OpenTelemetry (V7-Q): OTLP estándar al colector sidecar de cada nube (infra/otel/collector.<nube>.yaml). Cada señal
# se enciende solo si su exportador lo pide; sin ninguno (o OTEL_SDK_DISABLED=true) el SDK ni se carga.
# OTEL_TRACES_EXPORTER=otlp  OTEL_METRICS_EXPORTER=otlp  OTEL_LOGS_EXPORTER=none   # logs: JSON a stdout siempre
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318  OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_TRACES_SAMPLER=parentbased_traceidratio  OTEL_TRACES_SAMPLER_ARG=0.1  OTEL_METRIC_EXPORT_INTERVAL=60000
# OTEL_RESOURCE_ATTRIBUTES=cloud.region=us-east1   OTEL_SERVICE_NAME=   # por defecto mirai-<MODE>

# Tiempo real (F2-G, MODE=realtime = servicio mirai-realtime; ver apps/api/README.md › Tiempo real)
# REDIS_URL=                        # [secreto si lleva clave] Memorystore: varias instancias (adaptador + presencia). Sin ella, memoria
# REALTIME_PATH=/socket.io
# REALTIME_TOKEN_CHECK_S=600        # revisa token vencido y membresía cada 10 min
# REALTIME_PRESENCE_TTL_S=60        # presencia sin latido se olvida
# REALTIME_RECOVERY_S=120           # recuperación de la conexión (solo sin Redis)
# REALTIME_MAX_BOOKS=5  REALTIME_EVENTS_PER_10S=40
# REALTIME_PG_LISTEN=0              # 1 = LISTEN mirai_live (fase 4; necesita mirai_live_notify_install(true) en la base)
# REALTIME_DATABASE_URL=            # [secreto] conexión DIRECTA de sesión para LISTEN (si falta, DATABASE_URL)
# REALTIME_API_EMIT=1               # MODE=api: publica los cambios de la API en Redis para el gateway (si hay REDIS_URL)

# ── F2-E: avisos, integraciones, Google y trabajos (modules/integrations/services-env.ts) ──
SITE_URL=http://localhost:3000      # la web (enlaces de correos y avisos, regreso de Google). Por defecto según MIRAI_ENV
API_PUBLIC_URL=http://localhost:8080   # esta API (callback de Google: <API_PUBLIC_URL>/v1/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=               # [secreto]
GOOGLE_OAUTH_STATE_KEY=             # [secreto] HMAC del state de OAuth (32+ caracteres; openssl rand -base64 32)
VAPID_PUBLIC_KEY=                   # la misma NEXT_PUBLIC_VAPID_PUBLIC_KEY de la web
VAPID_PRIVATE_KEY=                  # [secreto]
VAPID_SUBJECT=mailto:soporte@mirai.app
# AI_GATEWAY_API_KEY=               # [secreto] solo para que el registro dé por lista la IA del despliegue
TICK_DAILY_TASKS=1                  # 0 si Cloud Scheduler ya llama aparte refs/calendar/net-worth/plan-reminders
AUTOMATIONS_OUTBOX=1                # encolar automations/book/:b después de cada escritura de la API

# ── F2-I: planes y pagos (modules/billing/billing.config.ts). SITE_URL (arriba) también arma invitaciones y retornos ──
MERCADOPAGO_ACCESS_TOKEN=           # [secreto] sin él, el pago con tarjeta se muestra deshabilitado
MERCADOPAGO_WEBHOOK_SECRET=         # [secreto] firma x-signature (obligatoria con MIRAI_ENV=produccion)
WOMPI_PUBLIC_KEY=                   # la misma NEXT_PUBLIC_WOMPI_PUBLIC_KEY de la web
WOMPI_INTEGRITY_SECRET=             # [secreto] firma de integridad del checkout
WOMPI_EVENTS_SECRET=                # [secreto] checksum de los eventos (webhook)

# ── V7-A: auth propio (modules/auth/auth.env.ts). Con AUTH_PROVIDER=supabase (por defecto) nada cambia ──
AUTH_PROVIDER=supabase              # supabase | mirai (Better Auth en /api/auth/* del mismo origen de la web)
# BETTER_AUTH_SECRET=               # [secreto] 32+ caracteres (openssl rand -base64 48). Firma cookies y cifra TOTP: NUNCA cambiarla
# BETTER_AUTH_URL=https://mirai.engynex.com   # origen público de la web (obligatorio fuera de local)
# AUTH_DATABASE_URL=                # [secreto] Postgres con el esquema `auth` (si falta, DATABASE_URL)
# AUTH_TRUSTED_ORIGINS=             # coma; si falta, WEB_ORIGINS
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (arriba): también "Entrar con Google" → <BETTER_AUTH_URL>/api/auth/callback/google
# TURNSTILE_SECRET_KEY=             # [secreto] Cloudflare Turnstile en registro y entrada (si falta, sin captcha)
# AUTH_MAIL_DRIVER=services         # services (proveedor de correo de la plataforma) | log (local: el enlace va al log) | memory
# AUTH_MAIL_FROM=no-responder@mirai.engynex.com
# AUTH_SUPPORT_URL=                 # enlace "escríbenos" de los correos

# ── V7-E: archivos (core/files/files.config.ts). Por defecto Supabase Storage, como hoy ──
OBJECT_STORE=supabase               # supabase | gcs | s3 | azure-blob | memory
# STORAGE_BUCKET_PRIVATE= STORAGE_BUCKET_BACKUPS= STORAGE_BUCKET_PUBLIC=   # buckets físicos (Azure: cuentas)
# PUBLIC_FILES_URL=https://files.mirai.engynex.com   # CDN del bucket público (avatars/, ads/, public-assets/)
# gcs: ADC (cuenta del servicio; firma V4 con signBlob, necesita iam.serviceAccountTokenCreator sobre sí misma)
# GCS_ENDPOINT=http://127.0.0.1:59401  GCS_SIGNED_HOST=   # solo fake-gcs-server en local
# s3: cadena estándar de credenciales de AWS (rol de la tarea); MinIO/R2 con S3_ENDPOINT
# S3_REGION=us-east-1  S3_ENDPOINT=  S3_PUBLIC_ENDPOINT=  S3_FORCE_PATH_STYLE=1
# azure-blob: identidad administrada + SAS de delegación (Storage Blob Data Contributor + Delegator)
# AZURE_STORAGE_ACCOUNT_PRIVATE= AZURE_STORAGE_ACCOUNT_BACKUPS= AZURE_STORAGE_ACCOUNT_PUBLIC=  AZURE_STORAGE_CONTAINER=objetos
# AZURE_STORAGE_ENDPOINT=https://{account}.blob.core.windows.net
# AZURE_STORAGE_CONNECTION_STRING=  # [secreto] solo Azurite/desarrollo
# Copia desde Supabase: node dist/storage-copy.js --dry-run (src/tools/storage-copy.ts; usa SUPABASE_URL + SUPABASE_SECRET_KEY)

# ── V7-P: IA de la plataforma sin Vercel (packages/ai/src/providers). Vacías = como hoy ──
# AI_PLATFORM_PROVIDER=vertex       # vertex | bedrock | azure | gateway | none (cuál va primero en el respaldo)
# GOOGLE_VERTEX_PROJECT=  GOOGLE_VERTEX_LOCATION=us-central1   # Vertex AI con ADC (roles/aiplatform.user)
# AI_BEDROCK_REGION=us-east-1       # Bedrock con el rol de la tarea (bedrock:InvokeModel*); AWS_BEARER_TOKEN_BEDROCK= [secreto] opcional
# AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com   # identidad administrada (Cognitive Services OpenAI User)
# AZURE_OPENAI_API_KEY=             # [secreto] opcional
