# ======================================================================
#  Mirai Server — variables de entorno
#  En Vercel: Project › Settings › Environment Variables
#  En VPS/Docker: copia este archivo como .env
# ======================================================================

# ===== Seguridad (obligatorias) =====
MIRAI_TOKEN=pon-aqui-un-token-largo-y-secreto     # se pega en Mirai › Ajustes › Servidor y conexiones
ENCRYPTION_KEY=                                    # openssl rand -base64 32  (cifra las claves que guardas desde Mirai)
CRON_SECRET=otro-secreto-para-el-cron              # Vercel lo envía solo como "Authorization: Bearer"
ALLOWED_ORIGINS=*                                  # o https://mirai.tudominio.com

# ===== Base de datos =====
STORE=supabase                                     # supabase (Vercel) | firestore (Cloud Run) | file (VPS)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                         # Supabase › Project Settings › API › service_role (¡secreta!)
# DATA_FILE=./data/mirai.json                      # solo con STORE=file
# FIRESTORE_COLLECTION=mirai_alerts                # solo con STORE=firestore
# INTERNAL_CRON=1                                  # solo Express sin cron externo

# ======================================================================
#  OPCIONAL: todo lo de abajo se puede configurar desde la app
#  (Ajustes › Alertas y notificaciones). Lo guardado en la app tiene prioridad.
# ======================================================================
# EMAIL_PROVIDER=resend                            # gmail | sendgrid | resend | smtp
# EMAIL_FROM=Mirai <avisos@tudominio.com>
# SENDGRID_API_KEY=
# RESEND_API_KEY=
# GMAIL_APP_PASSWORD=
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=avisos@tudominio.com
# SMTP_PASS=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=mirai_resumen
# WHATSAPP_TEMPLATE_LANG=es
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
