# Copia a terraform.tfvars (ignorado por git). Aquí NO van secretos (docs/infra/runbook.md §2).

project_id      = "engynex-mirai-prod"
cicd_project_id = "engynex-mirai-cicd"
region          = "us-west1"
bucket_suffix   = "engynex"

artifact_registry_path   = "us-west1-docker.pkg.dev/engynex-mirai-cicd/mirai"
artifact_registry_repo   = "mirai"
cloudbuild_repository_id = null

# Etapa 1. En la etapa 2 (cron y colas en GCP): scheduler_paused = false y se apaga pg_cron (runbook §5).
stages = {
  load_balancer     = true
  storage           = true
  cloud_sql         = false
  redis             = false
  realtime          = false
  identity_platform = false
  scheduler_paused  = true
  uptime_checks     = false
}

public_config = {
  NEXT_PUBLIC_SUPABASE_URL             = "https://ofcuvjixvtdixcwzdzqa.supabase.co"
  NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY = "sb_publishable_REEMPLAZA"
  NEXT_PUBLIC_LEGAL_OWNER              = "Engynex S.A.S."
  NEXT_PUBLIC_LEGAL_NIT                = "REEMPLAZA"
  NEXT_PUBLIC_LEGAL_EMAIL              = "datos@engynex.com"
  NEXT_PUBLIC_LEGAL_CITY               = "Bogotá D.C., Colombia"
  GOOGLE_CLIENT_ID                     = "REEMPLAZA.apps.googleusercontent.com"
  NEXT_PUBLIC_VAPID_PUBLIC_KEY         = "REEMPLAZA"
  VAPID_SUBJECT                        = "mailto:soporte@engynex.com"
  NEXT_PUBLIC_WOMPI_PUBLIC_KEY         = "pub_prod_REEMPLAZA"
  NEXT_PUBLIC_SENTRY_DSN               = ""
  MIRAI_CSP_ENFORCE                    = "0"
}

optional_secrets = [
  # "google-client-secret",
  # "google-oauth-state-key",     # HMAC del state de Google en la API (sin él no se conecta Gmail/Calendar)
  # "vapid-private-key",
  # "ai-gateway-api-key",
  # "upstash-redis-rest-token",   # solo la web
  # "mercadopago-access-token",
  # "mercadopago-webhook-secret", # obligatorio en producción para procesar webhooks de Mercado Pago en la API
  # "wompi-integrity-secret",
  # "wompi-events-secret",
  # "database-url",               # fase 4: necesario para db_adapter = "pg" o REALTIME_PG_LISTEN=1
]

# WEB_ORIGINS ya incluye https://mirai.engynex.com y canary.: la web en Vercel (fase 2) usa el mismo dominio.
# extra_web_origins = []

# Tiempo real (fase 4, con stages.redis = true y stages.realtime = true): la web usa el gateway.
# live_source  = "gateway"
# realtime_env = { REALTIME_PG_LISTEN = "1" }

alert_emails = {
  dueno = "alertas@engynex.com"
}

billing_account = null
budget_amount   = 250
budget_currency = "USD"

cloud_sql_iam_users = {
  # dueno = "dueno@engynex.com"
}
