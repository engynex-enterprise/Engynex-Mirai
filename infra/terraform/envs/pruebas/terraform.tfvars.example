# Copia a terraform.tfvars (ignorado por git). Aquí NO van secretos: esos se cargan en Secret Manager
# (docs/infra/runbook.md §2). Los valores NEXT_PUBLIC_* son públicos (van al navegador).

project_id      = "engynex-mirai-pruebas"
cicd_project_id = "engynex-mirai-cicd"
region          = "us-west1"
bucket_suffix   = "engynex"

# Salidas del bootstrap
artifact_registry_path   = "us-west1-docker.pkg.dev/engynex-mirai-cicd/mirai"
artifact_registry_repo   = "mirai"
cloudbuild_repository_id = null # "projects/engynex-mirai-cicd/locations/us-west1/connections/github/repositories/mirai"

# Etapa 1: API y web en Cloud Run con Supabase. Cron en pausa (base compartida con producción).
stages = {
  load_balancer     = true
  storage           = true
  cloud_sql         = false
  redis             = false
  realtime          = false
  identity_platform = false
  scheduler_paused  = true
  uptime_checks     = false
}

public_config = {
  NEXT_PUBLIC_SUPABASE_URL             = "https://ofcuvjixvtdixcwzdzqa.supabase.co"
  NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY = "sb_publishable_REEMPLAZA"
  NEXT_PUBLIC_LEGAL_OWNER              = "Engynex S.A.S."
  NEXT_PUBLIC_LEGAL_NIT                = "REEMPLAZA"
  NEXT_PUBLIC_LEGAL_EMAIL              = "datos@engynex.com"
  NEXT_PUBLIC_LEGAL_CITY               = "Bogotá D.C., Colombia"
  GOOGLE_CLIENT_ID                     = "REEMPLAZA.apps.googleusercontent.com"
  NEXT_PUBLIC_VAPID_PUBLIC_KEY         = "REEMPLAZA"
  VAPID_SUBJECT                        = "mailto:soporte@engynex.com"
  NEXT_PUBLIC_WOMPI_PUBLIC_KEY         = "pub_test_REEMPLAZA"
  MIRAI_CSP_ENFORCE                    = "0"
}

# Se agregan aquí a medida que se carga su valor (Cloud Run no arranca si un secreto montado está vacío).
optional_secrets = [
  # "google-client-secret",
  # "google-oauth-state-key",   # HMAC del state de Google en la API (sin él no se conecta Gmail/Calendar)
  # "vapid-private-key",
  # "ai-gateway-api-key",
  # "mercadopago-access-token", # credenciales de PRUEBA
  # "mercadopago-webhook-secret",
  # "wompi-integrity-secret",
  # "wompi-events-secret",
  # "database-url",             # fase 4: necesario para db_adapter = "pg" o REALTIME_PG_LISTEN=1
]

# Transición (fase 2): la web sigue en Vercel y llama a esta API → su origen debe estar en WEB_ORIGINS.
# extra_web_origins = ["https://engynex-mirai-pruebas.vercel.app"]

# Tiempo real (fase 4, con stages.realtime = true): la web usa el gateway en vez de Supabase Realtime.
# live_source  = "gateway"
# realtime_env = { REALTIME_PG_LISTEN = "1" }   # con Cloud SQL y mirai_live_notify_install(true)

alert_emails = {
  dueno = "alertas@engynex.com"
}

billing_account = null # "000000-000000-000000"
budget_amount   = 60
budget_currency = "USD"
