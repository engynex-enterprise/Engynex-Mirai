{
  "title": "Mirai · base (OpenTelemetry)",
  "uid": "mirai-otel-base",
  "description": "Panel base portable (V7-Q): PromQL sobre las métricas OTLP de Mirai. Sirve con Prometheus local (infra/otel/compose.yaml --profile metrics), Managed Service for Prometheus (GCP), Amazon Managed Prometheus o Azure Monitor managed Prometheus. job = service.namespace/service.name (mirai/mirai-api, mirai/mirai-realtime, mirai/mirai-worker, mirai/mirai-web).",
  "tags": [
    "mirai",
    "opentelemetry"
  ],
  "timezone": "America/Bogota",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Fuente",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "job",
        "label": "Servicio",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count, job)",
          "refId": "job"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "env",
        "label": "Ambiente",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count, deployment_environment_name)",
          "refId": "env"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "HTTP (instrumentación http de OpenTelemetry: http.server.request.duration)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Peticiones por segundo",
      "description": "rate de http_server_request_duration_seconds_count por servicio.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_server_request_duration_seconds_count{job=~\"$job\", deployment_environment_name=~\"$env\"}[5m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errores 5xx (%)",
      "description": "Porcentaje de respuestas 5xx sobre el total.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (job) (rate(http_server_request_duration_seconds_count{job=~\"$job\", deployment_environment_name=~\"$env\", http_response_status_code=~\"5..\"}[5m])) / sum by (job) (rate(http_server_request_duration_seconds_count{job=~\"$job\", deployment_environment_name=~\"$env\"}[5m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latencia p50 / p95 / p99",
      "description": "Cuantiles del histograma http.server.request.duration (segundos).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, job) (rate(http_server_request_duration_seconds_bucket{job=~\"$job\", deployment_environment_name=~\"$env\"}[5m])))",
          "legendFormat": "p50 {{job}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_request_duration_seconds_bucket{job=~\"$job\", deployment_environment_name=~\"$env\"}[5m])))",
          "legendFormat": "p95 {{job}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, job) (rate(http_server_request_duration_seconds_bucket{job=~\"$job\", deployment_environment_name=~\"$env\"}[5m])))",
          "legendFormat": "p99 {{job}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Respuestas por código",
      "description": "Peticiones por segundo según http.response.status_code.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{job=~\"$job\", deployment_environment_name=~\"$env\"}[5m]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Colas (core/telemetry/metrics.ts: mirai.queue.*)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tareas encoladas",
      "description": "mirai.queue.enqueued por cola; deduped=true si ya existía con ese nombre.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue, deduped) (rate(mirai_queue_enqueued_total{job=~\"$job\", deployment_environment_name=~\"$env\"}[5m]))",
          "legendFormat": "{{queue}} deduped={{deduped}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tareas procesadas (ok / falla)",
      "description": "Conteo del histograma mirai.queue.job.duration por cola y resultado.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue, ok) (rate(mirai_queue_job_duration_milliseconds_count{job=~\"$job\", deployment_environment_name=~\"$env\"}[5m]))",
          "legendFormat": "{{queue}} ok={{ok}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Duración p95 de las tareas",
      "description": "Cuantil 95 de mirai.queue.job.duration (ms) por cola.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, queue) (rate(mirai_queue_job_duration_milliseconds_bucket{job=~\"$job\", deployment_environment_name=~\"$env\"}[5m])))",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Archivos (core/telemetry/metrics.ts: mirai.files.*)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Operaciones de archivos",
      "description": "mirai.files.ops por operación y resultado.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (op, ok) (rate(mirai_files_ops_total{job=~\"$job\", deployment_environment_name=~\"$env\"}[5m]))",
          "legendFormat": "{{op}} ok={{ok}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Bytes subidos por segundo",
      "description": "Suma de mirai.files.bytes por bucket.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 27,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (bucket) (rate(mirai_files_bytes_sum{job=~\"$job\", deployment_environment_name=~\"$env\"}[5m]))",
          "legendFormat": "{{bucket}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Tamaño p95 de las subidas",
      "description": "Cuantil 95 de mirai.files.bytes por bucket.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 27,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, bucket) (rate(mirai_files_bytes_bucket{job=~\"$job\", deployment_environment_name=~\"$env\"}[5m])))",
          "legendFormat": "{{bucket}}"
        }
      ]
    }
  ]
}