# Copia este archivo a .env.local (en la raíz). La web no guarda secretos: todo lo hace la API (apps/api/.env.example).
# infra/servidor/variables.mjs toma de aquí lo que el servidor necesita (ENCRYPTION_KEY, CRON_SECRET, Google, NEXT_PUBLIC_*…).
SUPABASE_DB_URL=postgresql://USUARIO:CLAVE@HOST:5432/mirai   # solo para pnpm db:migrate y db:types (el nombre es histórico)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENCRYPTION_KEY=                               # openssl rand -base64 32 — NO cambiar nunca
CRON_SECRET=                                  # openssl rand -hex 32
NEXT_PUBLIC_SITE_URL=https://tu-dominio.co
# Responsable del tratamiento de datos (Ley 1581)
NEXT_PUBLIC_LEGAL_OWNER=
NEXT_PUBLIC_LEGAL_NIT=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_LEGAL_CITY=Bogotá D.C., Colombia

# Pruebas E2E
E2E_QA_EMAIL=qa.e2e@mirai.test
E2E_QA_PASSWORD=

# IA de la plataforma (v7, V7-P): proveedor por defecto sin Vercel. Vacías = como hoy (AI Gateway opcional)
AI_GATEWAY_API_KEY=
# AI_PLATFORM_PROVIDER=vertex                # vertex | bedrock | azure | gateway | none
# GOOGLE_VERTEX_PROJECT= GOOGLE_VERTEX_LOCATION=us-central1
# AI_BEDROCK_REGION=us-east-1   AWS_BEARER_TOKEN_BEDROCK=
# AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com   AZURE_OPENAI_API_KEY=

# Web Push (VAPID): npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tudominio.co

# Cloudflare Turnstile (opcional; la clave secreta TURNSTILE_SECRET_KEY va en la API)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Upstash Redis (opcional): límite de consultas de IA por hogar
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Sentry (opcional)
NEXT_PUBLIC_SENTRY_DSN=
# Tiempo real: el gateway socket.io de la API. Vacío = el mismo dominio (/socket.io).
# NEXT_PUBLIC_REALTIME_URL=https://rt.mirai.engynex.com
# API de Mirai (obligatoria para la web): el servidor de Next la llama directo (en el compose, http://api:8080) y el
# navegador por /v1 y /api/auth del mismo dominio (la web los reenvía si el balanceador no lo hace).
# MIRAI_API_URL=http://localhost:8080

# ── API (v7). Lo completo en apps/api/.env.example ──
# Auth propio: Better Auth en la API (/api/auth/*, mismo origen que la web)
# BETTER_AUTH_SECRET=                         # solo servidor; 32+ caracteres; NUNCA cambiarla
# BETTER_AUTH_URL=https://mirai.engynex.com
# AUTH_DATABASE_URL=                          # solo servidor (si falta, DATABASE_URL)
# AUTH_TRUSTED_ORIGINS=
# AUTH_PROXY_HOPS=1                 # proxies de confianza delante de la API (IP real para los límites del login)
# TURNSTILE_SECRET_KEY=                       # solo servidor (la site key es NEXT_PUBLIC_TURNSTILE_SITE_KEY)
# AUTH_MAIL_DRIVER=services                   # services | log | memory
# AUTH_MAIL_FROM=no-responder@mirai.engynex.com
#
# ── Avisos de la plataforma: correo, WhatsApp y Telegram (solo la API) ──
# Con estas variables quedan ACTIVOS para todos los hogares sin entrar a consola › Integraciones globales: avisos,
# invitaciones y los correos de la cuenta (verificación, recuperación de clave, enlace mágico). Sin ninguna de ellas,
# Mirai dice "no hay un servicio de correo activo". Lo guardado en la consola manda sobre estas variables.
# Correo: basta UN proveedor. El remitente debe ser de un dominio verificado en él.
# MAIL_FROM=no-responder@mirai.engynex.com    # del dominio verificado en Resend; vacío: usa AUTH_MAIL_FROM
# MAIL_FROM_NAME=Mirai
# RESEND_API_KEY=                             # resend.com › API Keys (3.000 correos/mes gratis)
# BREVO_API_KEY=                              # o Brevo (300/día)
# SENDGRID_API_KEY=                           # o SendGrid
# GMAIL_USER= / GMAIL_APP_PASSWORD=           # o Gmail con contraseña de aplicación
# SMTP_HOST= / SMTP_PORT=465 / SMTP_SECURE=1 / SMTP_USER= / SMTP_PASS=   # o cualquier servidor SMTP
# WhatsApp Cloud API (Meta): token permanente del usuario del sistema + Phone number ID
# WHATSAPP_TOKEN= / WHATSAPP_PHONE_ID= / WHATSAPP_WABA_ID=
# WHATSAPP_TEMPLATE=mirai_resumen / WHATSAPP_LANG=es_CO
# TELEGRAM_BOT_TOKEN= / TELEGRAM_BOT_NAME=@MiraiFamiliaBot
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (arriba): redirección nueva <BETTER_AUTH_URL>/api/auth/callback/google
# Archivos: OBJECT_STORE=s3 | gcs | azure-blob (lo lee la API); la web sube por la API (/v1/files)
# OBJECT_STORE=s3  PUBLIC_FILES_URL=https://files.mirai.engynex.com
# Observabilidad (V7-Q): OTLP estándar (la web registra el SDK solo en el servidor de Next si están puestas)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318  OTEL_TRACES_EXPORTER=otlp  OTEL_SERVICE_NAME=mirai-web
