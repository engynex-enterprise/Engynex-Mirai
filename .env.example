# Copia este archivo a .env.local (local) o carga estas variables en Vercel › Settings › Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...            # solo servidor
SUPABASE_DB_URL=postgresql://postgres.TU-PROYECTO:CLAVE@aws-1-us-west-2.pooler.supabase.com:5432/postgres   # solo para migraciones locales
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENCRYPTION_KEY=                               # openssl rand -base64 32 — NO cambiar nunca
CRON_SECRET=                                  # openssl rand -hex 32
NEXT_PUBLIC_SITE_URL=https://tu-dominio.co        # opcional en Vercel: si falta, usa el dominio de producción (VERCEL_PROJECT_PRODUCTION_URL)
# Responsable del tratamiento de datos (Ley 1581)
NEXT_PUBLIC_LEGAL_OWNER=
NEXT_PUBLIC_LEGAL_NIT=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_LEGAL_CITY=Bogotá D.C., Colombia

# Pruebas E2E
E2E_QA_EMAIL=qa.e2e@mirai.test
E2E_QA_PASSWORD=

# IA de la plataforma (v7, V7-P): proveedor por defecto sin Vercel. Vacías = como hoy (AI Gateway opcional)
AI_GATEWAY_API_KEY=
# AI_PLATFORM_PROVIDER=vertex                # vertex | bedrock | azure | gateway | none
# GOOGLE_VERTEX_PROJECT= GOOGLE_VERTEX_LOCATION=us-central1
# AI_BEDROCK_REGION=us-east-1   AWS_BEARER_TOKEN_BEDROCK=
# AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com   AZURE_OPENAI_API_KEY=

# Web Push (VAPID): npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tudominio.co

# Cloudflare Turnstile (opcional; activa también la protección en Supabase › Auth)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Upstash Redis (opcional): límite de consultas de IA por hogar
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Sentry (opcional)
NEXT_PUBLIC_SENTRY_DSN=
# Tiempo real (v6 F2-G): fuente de los cambios en vivo. Vacío = Supabase Realtime (lo de hoy).
# NEXT_PUBLIC_LIVE_SOURCE=gateway            # supabase | gateway (solo con Cloud SQL, fase 4)
# NEXT_PUBLIC_REALTIME_URL=https://rt.mirai.engynex.com
# API de Mirai (v6 F2-H): apagada por defecto. Las dos variables se leen al correr (sin recompilar), pero la CSP toma
# MIRAI_API_URL al compilar. Procedimiento de encendido y apagado: docs/arquitectura/v6-f2h-encendido.md
# MIRAI_API_URL=https://api-pruebas.mirai.engynex.com
# MIRAI_API_ROLLOUT=off                      # off | db (platform_settings.api_rollout) | all (solo local/E2E) | {"chat":"on"}

# ── v7 (todo en GCP y portable). Lo de la API completo en apps/api/.env.example ──
# Auth propio (V7-A/B): con supabase (por defecto) nada cambia
AUTH_PROVIDER=supabase                        # supabase | mirai (Better Auth en /api/auth/*, mismo origen)
# BETTER_AUTH_SECRET=                         # solo servidor; 32+ caracteres; NUNCA cambiarla
# BETTER_AUTH_URL=https://mirai.engynex.com
# AUTH_DATABASE_URL=                          # solo servidor (si falta, DATABASE_URL)
# AUTH_TRUSTED_ORIGINS=
# TURNSTILE_SECRET_KEY=                       # solo servidor (la site key es NEXT_PUBLIC_TURNSTILE_SITE_KEY)
# AUTH_MAIL_DRIVER=services                   # services | log | memory
# AUTH_MAIL_FROM=no-responder@mirai.engynex.com
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (arriba): redirección nueva <BETTER_AUTH_URL>/api/auth/callback/google
# Archivos (V7-E): OBJECT_STORE=supabase | gcs | s3 | azure-blob (lo lee la API); la web sube por la API con el
# interruptor `files` de platform_settings.api_rollout
# OBJECT_STORE=supabase  PUBLIC_FILES_URL=https://files.mirai.engynex.com
# Observabilidad (V7-Q): OTLP estándar (la web registra el SDK solo en el servidor de Next si están puestas)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318  OTEL_TRACES_EXPORTER=otlp  OTEL_SERVICE_NAME=mirai-web
