{
  "name": "mirai",
  "version": "5.0.0",
  "private": true,
  "description": "Mirai (未来): finanzas personales y familiares para Colombia. Monorepo pnpm + Turborepo: apps/web (Next.js), apps/api (NestJS, fase 2) y packages/*.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build",
    "start": "pnpm --filter web start",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=web",
    "e2e:local": "node infra/local/e2e-local.mjs",
    "db:migrate": "turbo run db:migrate --filter=@mirai/db",
    "db:migrate:prod": "turbo run db:migrate:prod --filter=@mirai/db",
    "db:types": "turbo run db:types --filter=@mirai/db",
    "ci": "turbo run lint typecheck test build",
    "local:up": "node infra/local/stack.mjs up --supa",
    "local:down": "node infra/local/stack.mjs down",
    "local:reset": "node infra/local/stack.mjs reset --supa",
    "local:test": "node infra/local/stack.mjs test",
    "db:destino": "node packages/db/scripts/db-destino.mjs",
    "migrate:ensayo": "node --experimental-strip-types --no-warnings scripts/migrate/ensayo.ts"
  },
  "prettier": "@mirai/config/prettier",
  "devDependencies": {
    "@mirai/config": "workspace:*",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10"
  }
}
