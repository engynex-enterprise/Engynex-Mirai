{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint)", "Bash(pnpm typecheck)", "Bash(pnpm test)", "Bash(pnpm build)", "Bash(pnpm e2e:local:*)", "Bash(pnpm secretos)",
      "Bash(pnpm --filter:*)", "Bash(node scripts/revisar-secretos.mjs:*)", "Bash(pnpm db:migrate:vps -- --pendientes)",
      "Bash(git status)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git add:*)", "Bash(git commit:*)",
      "Read(**)", "Edit(docs/**)", "Edit(*.md)"
    ],
    "deny": [
      "Read(**/.env)", "Read(**/.env.local)", "Read(**/*.secretos)", "Bash(git push --force:*)", "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/revisar-secretos.mjs\" --hook", "timeout": 60 }
        ]
      }
    ]
  },
  "env": { "MIRAI_LANG": "es-CO" }
}
